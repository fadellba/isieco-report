{
  "expo": {
    "name": "ISI-Eco Report",
    "slug": "isieco-report",
    "scheme": "isiecoreport",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
