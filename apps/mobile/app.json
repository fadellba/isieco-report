{
  "expo": {
    "name": "ISIECO",
    "slug": "isieco-report",
    "scheme": "isiecoreport",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "imageWidth": 176,
      "backgroundColor": "#14532D",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez ISIECO à joindre des photos à vos signalements et interventions.",
          "cameraPermission": "Autorisez ISIECO à prendre des photos de preuves.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autorisez ISIECO à associer votre position à un signalement lorsque vous le demandez."
        }
      ]
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14532D"
      },
      "package": "com.isieco.report",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.isieco.report"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "20fe4494-6425-4720-a6a6-c586c13a94be"
      }
    },
    "owner": "fadelba"
  }
}
