{
  "name": "@isieco/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "nest build && node --test",
    "test:database:invariants": "node --test test/database-invariants.test.mjs",
    "openapi:generate": "nest build && node dist/openapi/generate-openapi.js",
    "storage:purge": "nest build && node dist/infrastructure/storage/media-purge.cli.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/config": "4.0.0",
    "@nestjs/swagger": "11.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@isieco/shared": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "jose": "6.1.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.0",
    "@nestjs/schematics": "11.0.0",
    "@types/express": "5.0.3",
    "@types/node": "24.0.0",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3"
  }
}
