generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Modèle métier simplifié du PFE : 18 tables.
// Les champs strictement techniques (idempotence, rétention des médias,
// clés d'authentification) sont conservés sans ajouter d'entités métier.
model Utilisateur {
  idUtilisateur  String   @id @default(uuid()) @db.Uuid @map("id_utilisateur")
  authUserId     String   @unique @db.Uuid @map("auth_user_id")
  nom            String
  prenom          String?
  email           String   @unique
  telephone       String?
  dateInscription DateTime @default(now()) @map("date_inscription")
  etatCompte      String   @default("ACTIF") @map("etat_compte")

  roles              UtilisateurRole[]
  rolesAttribues     UtilisateurRole[] @relation("RoleAttributedBy")
  signalements       Signalement[]
  signalementsDecides Signalement[] @relation("SignalementDecisionMaker")
  statutsModifies    HistoriqueStatutSignalement[]
  contenusQualifies  ContenuSignalement[] @relation("ContentQualifier")
  appartenances      AppartenanceEquipe[]
  dossiersCrees      DossierTraitement[]
  affectationsDecidees Affectation[] @relation("AssignmentDecider")
  affectationsRepondues Affectation[] @relation("AssignmentResponder")
  interventions      Intervention[] @relation("InterventionAuthor")
  verifications      Verification[] @relation("VerificationActor")
  demandesComplement DemandeComplement[] @relation("SupplementRequester")
  reponsesComplement DemandeComplement[] @relation("SupplementResponder")

  @@map("utilisateur")
}

model Role {
  idRole       String @id @default(uuid()) @db.Uuid @map("id_role")
  codeRole     String @unique @map("code_role")
  libelleRole  String @map("libelle_role")
  description  String?
  utilisateurs UtilisateurRole[]

  @@map("role")
}

model UtilisateurRole {
  idUtilisateur String   @db.Uuid @map("id_utilisateur")
  idRole        String   @db.Uuid @map("id_role")
  dateDebut     DateTime @default(now()) @map("date_debut")
  dateFin       DateTime? @map("date_fin")
  attribuePar   String?  @db.Uuid @map("attribue_par")
  motif         String?
  utilisateur   Utilisateur @relation(fields: [idUtilisateur], references: [idUtilisateur], onDelete: Cascade)
  role          Role        @relation(fields: [idRole], references: [idRole], onDelete: Restrict)
  attribuant    Utilisateur? @relation("RoleAttributedBy", fields: [attribuePar], references: [idUtilisateur], onDelete: SetNull)

  @@id([idUtilisateur, idRole, dateDebut])
  @@index([idRole, dateFin])
  @@map("utilisateur_role")
}

model TypeDechet {
  idTypeDechet String @id @default(uuid()) @db.Uuid @map("id_type_dechet")
  codeType     String @unique @map("code_type")
  libelle      String
  description  String?
  actif        Boolean @default(true)

  contenusSignalement ContenuSignalement[]
  contenusDossier     ContenuDossier[]
  competences         CompetenceEquipe[]

  @@map("type_dechet")
}

model Equipe {
  idEquipe      String @id @default(uuid()) @db.Uuid @map("id_equipe")
  nomEquipe     String @map("nom_equipe")
  description   String?
  etatEquipe    String @map("etat_equipe")

  appartenances AppartenanceEquipe[]
  competences   CompetenceEquipe[]
  affectations  Affectation[]

  @@map("equipe")
}

model AppartenanceEquipe {
  idUtilisateur String   @db.Uuid @map("id_utilisateur")
  idEquipe      String   @db.Uuid @map("id_equipe")
  dateDebut     DateTime @map("date_debut")
  dateFin       DateTime? @map("date_fin")
  fonction      String
  utilisateur   Utilisateur @relation(fields: [idUtilisateur], references: [idUtilisateur], onDelete: Restrict)
  equipe        Equipe      @relation(fields: [idEquipe], references: [idEquipe], onDelete: Restrict)

  @@id([idUtilisateur, idEquipe, dateDebut])
  @@index([idEquipe, dateFin])
  @@map("appartenance_equipe")
}

model CompetenceEquipe {
  idCompetenceEquipe String @id @default(uuid()) @db.Uuid @map("id_competence_equipe")
  idEquipe           String @db.Uuid @map("id_equipe")
  idTypeDechet       String @db.Uuid @map("id_type_dechet")
  actif              Boolean @default(true)
  dateAttribution    DateTime @default(now()) @map("date_attribution")
  commentaire        String?
  equipe             Equipe @relation(fields: [idEquipe], references: [idEquipe], onDelete: Restrict)
  typeDechet         TypeDechet @relation(fields: [idTypeDechet], references: [idTypeDechet], onDelete: Restrict)
  affectations       Affectation[]

  @@unique([idEquipe, idTypeDechet], map: "competence_equipe_one_team_type_idx")
  @@map("competence_equipe")
}

model DossierTraitement {
  idDossier               String @id @default(uuid()) @db.Uuid @map("id_dossier")
  referenceDossier        String @unique @map("reference_dossier")
  descriptionSynthese     String @db.Text @map("description_synthese")
  dateCreationDossier     DateTime @map("date_creation_dossier")
  statutDossier           String @map("statut_dossier")
  priorite                String
  latitude                Decimal? @db.Decimal(9, 6)
  longitude               Decimal? @db.Decimal(9, 6)
  precisionLocalisation   Decimal? @db.Decimal(9, 2) @map("precision_localisation")
  descriptionLocalisation String? @map("description_localisation")
  dateCloture             DateTime? @map("date_cloture")
  creePar                 String @db.Uuid @map("cree_par")

  createur      Utilisateur @relation(fields: [creePar], references: [idUtilisateur], onDelete: Restrict)
  signalements  Signalement[]
  contenus      ContenuDossier[]

  @@index([statutDossier, priorite])
  @@map("dossier_traitement")
}

model Signalement {
  idSignalement           String @id @default(uuid()) @db.Uuid @map("id_signalement")
  idUtilisateur           String @db.Uuid @map("id_utilisateur")
  idDossier               String? @db.Uuid @map("id_dossier")
  dateConstat             DateTime? @map("date_constat")
  dateSoumission          DateTime? @map("date_soumission")
  description             String? @db.Text
  localisation            String? @map("description_localisation")
  latitude                Decimal? @db.Decimal(9, 6)
  longitude               Decimal? @db.Decimal(9, 6)
  precisionLocalisation   Decimal? @db.Decimal(9, 2) @map("precision_localisation")
  statutSignalement       String @map("statut_signalement")
  decisionPar             String? @db.Uuid @map("decision_par")
  dateDecision            DateTime? @map("date_decision")
  motifDecision           String? @map("motif_decision")
  cleIdempotence          String? @map("cle_idempotence")
  empreinteRequete        String? @map("empreinte_requete")

  utilisateur       Utilisateur @relation(fields: [idUtilisateur], references: [idUtilisateur], onDelete: Restrict)
  decideur          Utilisateur? @relation("SignalementDecisionMaker", fields: [decisionPar], references: [idUtilisateur], onDelete: SetNull)
  dossier           DossierTraitement? @relation(fields: [idDossier], references: [idDossier], onDelete: SetNull)
  photos            PhotoSignalement[]
  contenus          ContenuSignalement[]
  historiquesStatut HistoriqueStatutSignalement[]
  demandesComplement DemandeComplement[]

  @@unique([idUtilisateur, cleIdempotence])
  @@index([idUtilisateur, dateSoumission])
  @@index([idDossier, statutSignalement])
  @@map("signalement")
}

model PhotoSignalement {
  idPhotoSignalement String @id @default(uuid()) @db.Uuid @map("id_photo_signalement")
  referencePhoto     String @map("reference_photo")
  description        String?
  dateAjout          DateTime @map("date_ajout")
  idSignalement      String @db.Uuid @map("id_signalement")
  dateExpiration     DateTime @map("date_expiration")
  mediaPurgeAt       DateTime? @map("media_purge_at")

  signalement Signalement @relation(fields: [idSignalement], references: [idSignalement], onDelete: Restrict)

  @@index([idSignalement, dateAjout])
  @@index([dateExpiration, mediaPurgeAt])
  @@map("photo_signalement")
}

model ContenuSignalement {
  idContenuSignalement String @id @default(uuid()) @db.Uuid @map("id_contenu_signalement")
  idSignalement        String @db.Uuid @map("id_signalement")
  idTypeDechet         String @db.Uuid @map("id_type_dechet")
  quantiteEstimee      Decimal? @db.Decimal(12, 3) @map("quantite_estimee")
  volumeEstime         Decimal? @db.Decimal(12, 3) @map("volume_estime")
  remarque             String?
  etatQualification    String @default("EN_ATTENTE") @map("etat_qualification")
  qualifiePar           String? @db.Uuid @map("qualifie_par")
  dateQualification    DateTime? @map("date_qualification")

  signalement Signalement @relation(fields: [idSignalement], references: [idSignalement], onDelete: Restrict)
  typeDechet  TypeDechet @relation(fields: [idTypeDechet], references: [idTypeDechet], onDelete: Restrict)
  qualificateur Utilisateur? @relation("ContentQualifier", fields: [qualifiePar], references: [idUtilisateur], onDelete: SetNull)

  @@unique([idSignalement, idTypeDechet])
  @@index([idSignalement, etatQualification], map: "contenu_signalement_report_qualification_idx")
  @@map("contenu_signalement")
}

model HistoriqueStatutSignalement {
  idHistoriqueStatut String @id @default(uuid()) @db.Uuid @map("id_historique_statut")
  idSignalement      String @db.Uuid @map("id_signalement")
  idUtilisateur      String? @db.Uuid @map("id_utilisateur")
  ancienStatut       String? @map("ancien_statut")
  nouveauStatut      String @map("nouveau_statut")
  dateChangement     DateTime @default(now()) @map("date_changement")
  motif              String?

  signalement Signalement @relation(fields: [idSignalement], references: [idSignalement], onDelete: Restrict)
  utilisateur Utilisateur? @relation(fields: [idUtilisateur], references: [idUtilisateur], onDelete: SetNull)

  @@index([idSignalement, dateChangement], map: "historique_statut_signalement_date_idx")
  @@map("historique_statut_signalement")
}

model DemandeComplement {
  idDemande     String @id @default(uuid()) @db.Uuid @map("id_demande")
  idSignalement String @db.Uuid @map("id_signalement")
  demandePar    String @db.Uuid @map("demande_par")
  dateDemande   DateTime @map("date_demande")
  motif         String
  etatDemande   String @map("etat_demande")
  reponse       String? @db.Text
  reponduPar    String? @db.Uuid @map("repondu_par")
  dateReponse   DateTime? @map("date_reponse")

  signalement Signalement @relation(fields: [idSignalement], references: [idSignalement], onDelete: Restrict)
  demandeur   Utilisateur @relation("SupplementRequester", fields: [demandePar], references: [idUtilisateur], onDelete: Restrict)
  repondant   Utilisateur? @relation("SupplementResponder", fields: [reponduPar], references: [idUtilisateur], onDelete: SetNull)

  @@index([idSignalement, etatDemande])
  @@map("demande_complement")
}

model ContenuDossier {
  idContenuDossier String @id @default(uuid()) @db.Uuid @map("id_contenu_dossier")
  idDossier        String @db.Uuid @map("id_dossier")
  idTypeDechet     String @db.Uuid @map("id_type_dechet")
  quantiteEstimee  Decimal? @db.Decimal(12, 3) @map("quantite_estimee")
  uniteQuantite    String? @map("unite_quantite")
  volumeEstime     Decimal? @db.Decimal(12, 3) @map("volume_estime")
  remarque         String?
  etatContenuDossier String @map("etat_contenu_dossier")
  etatPriseEnCharge  String @map("etat_prise_en_charge")

  dossier    DossierTraitement @relation(fields: [idDossier], references: [idDossier], onDelete: Restrict)
  typeDechet TypeDechet @relation(fields: [idTypeDechet], references: [idTypeDechet], onDelete: Restrict)
  affectations Affectation[]

  @@unique([idDossier, idTypeDechet])
  @@index([idDossier, etatContenuDossier, etatPriseEnCharge], map: "contenu_dossier_case_content_state_idx")
  @@map("contenu_dossier")
}

model Affectation {
  idAffectation            String @id @default(uuid()) @db.Uuid @map("id_affectation")
  idContenuDossier         String @db.Uuid @map("id_contenu_dossier")
  idEquipe                 String @db.Uuid @map("id_equipe")
  idCompetenceEquipe       String @db.Uuid @map("id_competence_equipe")
  dateHeureAffectation     DateTime @map("date_heure_affectation")
  idDecideur               String @db.Uuid @map("id_decideur")
  etatAffectation          String @map("etat_affectation")
  motif                    String?
  observation              String?
  dateFinAffectation       DateTime? @map("date_fin_affectation")
  decisionEquipe           String @map("decision_equipe")
  reponduPar               String? @db.Uuid @map("repondu_par")
  dateReponseEquipe        DateTime? @map("date_reponse_equipe")
  motifRefusEquipe         String? @map("motif_refus_equipe")
  referenceOperationUnique String? @unique @map("reference_operation_unique")

  contenuDossier ContenuDossier @relation(fields: [idContenuDossier], references: [idContenuDossier], onDelete: Restrict)
  equipe         Equipe @relation(fields: [idEquipe], references: [idEquipe], onDelete: Restrict)
  competence     CompetenceEquipe @relation(fields: [idCompetenceEquipe], references: [idCompetenceEquipe], onDelete: Restrict)
  decideur       Utilisateur @relation("AssignmentDecider", fields: [idDecideur], references: [idUtilisateur], onDelete: Restrict)
  repondant      Utilisateur? @relation("AssignmentResponder", fields: [reponduPar], references: [idUtilisateur], onDelete: SetNull)
  interventions  Intervention[]

  @@index([idContenuDossier, dateFinAffectation], map: "affectation_content_closure_idx")
  @@index([idEquipe, etatAffectation])
  @@map("affectation")
}

model Intervention {
  idIntervention            String @id @default(uuid()) @db.Uuid @map("id_intervention")
  idAffectation             String @db.Uuid @map("id_affectation")
  dateHeureDebut            DateTime? @map("date_heure_debut")
  dateHeureFin              DateTime? @map("date_heure_fin")
  dateSoumissionCompteRendu DateTime? @map("date_soumission_compte_rendu")
  statutIntervention        String @map("statut_intervention")
  resultatIntervention      String? @map("resultat_intervention")
  compteRendu               String? @db.Text @map("compte_rendu")
  motifException            String? @map("motif_exception")
  renseignePar              String @db.Uuid @map("renseigne_par")

  affectation Affectation @relation(fields: [idAffectation], references: [idAffectation], onDelete: Restrict)
  redacteur   Utilisateur @relation("InterventionAuthor", fields: [renseignePar], references: [idUtilisateur], onDelete: Restrict)
  photos      PhotoIntervention[]
  verification Verification?

  @@index([idAffectation, statutIntervention])
  @@map("intervention")
}

model PhotoIntervention {
  idPhotoIntervention String @id @default(uuid()) @db.Uuid @map("id_photo_intervention")
  idIntervention      String @db.Uuid @map("id_intervention")
  referencePhoto      String @map("reference_photo")
  contextePhoto       String @map("contexte_photo")
  description         String?
  dateAjout           DateTime @map("date_ajout")
  dateExpiration      DateTime @map("date_expiration")
  mediaPurgeAt        DateTime? @map("media_purge_at")

  intervention Intervention @relation(fields: [idIntervention], references: [idIntervention], onDelete: Restrict)

  @@index([idIntervention, dateAjout])
  @@index([dateExpiration, mediaPurgeAt])
  @@map("photo_intervention")
}

model Verification {
  idVerification       String @id @default(uuid()) @db.Uuid @map("id_verification")
  idIntervention       String? @unique @db.Uuid @map("id_intervention")
  idVerificateur       String @db.Uuid @map("id_verificateur")
  dateVerification     DateTime @map("date_verification")
  resultatVerification String @map("resultat_verification")
  motif                String?

  intervention Intervention? @relation(fields: [idIntervention], references: [idIntervention], onDelete: Restrict)
  verificateur  Utilisateur @relation("VerificationActor", fields: [idVerificateur], references: [idUtilisateur], onDelete: Restrict)

  @@index([dateVerification], map: "verification_date_idx")
  @@map("verification")
}
