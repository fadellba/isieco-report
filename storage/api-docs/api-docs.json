{
    "openapi": "3.0.0",
    "info": {
        "title": "ISI-Eco-Report API",
        "description": "API de signalement et de gestion des déchets sauvages. Permet l'authentification des utilisateurs (Citoyens, Agents et Administrateurs), le signalement géolocalisé avec photo, l'affectation à des brigades de collecte, le suivi des interventions terrain et l'attribution automatique de points de fidélité.",
        "version": "1.0.0"
    },
    "paths": {
        "/auth/register": {
            "post": {
                "tags": [
                    "Authentification"
                ],
                "summary": "Inscription citoyenne",
                "description": "Permet aux nouveaux citoyens de créer un compte. Rôle par défaut : 'citizen'.",
                "operationId": "f18a0c4b85d7508bf5f73ad13af12198",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "nom",
                                    "prenom",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "nom": {
                                        "type": "string",
                                        "example": "Sow"
                                    },
                                    "prenom": {
                                        "type": "string",
                                        "example": "Mamadou"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "mamadou@gmail.com"
                                    },
                                    "telephone": {
                                        "type": "string",
                                        "example": "775283814"
                                    },
                                    "adresse": {
                                        "type": "string",
                                        "example": "Fann Résidence, Dakar"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Citoyen créé avec succès"
                    },
                    "422": {
                        "description": "Données de validation invalides"
                    }
                },
                "servers": [
                    {
                        "url": "/api",
                        "description": "Serveur API local"
                    }
                ]
            }
        },
        "/auth/login": {
            "post": {
                "tags": [
                    "Authentification"
                ],
                "summary": "Connexion de l'utilisateur",
                "description": "Permet aux Citoyens, Agents et Admins de se connecter et d'obtenir un jeton d'accès.",
                "operationId": "c6c9874077b7f3ebeda92067d8d9fa9f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "admin@isieco.sn"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Connexion réussie avec token"
                    },
                    "401": {
                        "description": "Identifiants invalides"
                    }
                },
                "servers": [
                    {
                        "url": "/api",
                        "description": "Serveur API local"
                    }
                ]
            }
        },
